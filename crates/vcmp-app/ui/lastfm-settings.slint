import { Theme } from "theme.slint";
import { Button, SettingRow, TextLink, Toggle } from "components.slint";
import { LastfmImport, LastfmProblem, LastfmState, LastfmStatus } from "lastfm-state.slint";

// "Love on Last.fm": hearts given from now on are loved there too. Shown while an
// account is connected.
export component LastfmLoveRow inherits SettingRow {
    title: @tr("Love on Last.fm");
    description: @tr("Tracks you add to Favourites from now on are loved on Last.fm too, and removing them unloves them there. Tracks already in Favourites are not sent.");
    forward-focus: toggle;

    toggle := Toggle {
        label: @tr("Love on Last.fm");
        checked: LastfmState.love;
        toggled(on) => {
            LastfmState.set-love(on);
        }
    }
}

// "Import loved tracks from Last.fm": likes the library tracks the account loved,
// with the pages read while it runs and what matched afterwards.
export component LastfmImportRow inherits SettingRow {
    private property <LastfmImport> result: LastfmState.import-result;
    private property <string> matched: @tr("{n} loved track is in Favourites now." | "{n} loved tracks are in Favourites now." % LastfmState.import-matched);
    private property <string> unmatched: @tr("{n} loved track matched no track in your library." | "{n} loved tracks matched no track in your library." % LastfmState.import-unmatched);

    title: @tr("Import loved tracks from Last.fm");
    description: LastfmState.importing
        ? (LastfmState.import-pages > 0
        ? @tr("Reading your loved tracks, page {0} of {1}…", LastfmState.import-page, LastfmState.import-pages)
        : @tr("Reading your loved tracks…"))
        // Two sentences, the second only when some matched nothing.
        : root.result == LastfmImport.done ? (LastfmState.import-unmatched > 0 ? @tr("{0} {1}", root.matched, root.unmatched) : root.matched)
        : root.result == LastfmImport.failed ? @tr("VCMP couldn't read your loved tracks from Last.fm: {}", LastfmState.import-detail)
        : root.result == LastfmImport.not-liked ? @tr("VCMP couldn't add the matching tracks to Favourites: {}", LastfmState.import-detail)
        : root.result == LastfmImport.no-account ? @tr("Connect a Last.fm account to import its loved tracks.")
        : @tr("Adds the tracks in your library that you loved on Last.fm to Favourites, matched by artist and title. It never removes anything, and you can run it again.");
    forward-focus: button;

    button := Button {
        text: LastfmState.importing ? @tr("Importing…") : @tr("Import");
        label: @tr("Import loved tracks from Last.fm");
        enabled: !LastfmState.importing;
        clicked => {
            LastfmState.import-loved();
        }
    }
}

// The Last.fm setting: connect an account, wait while the user allows VCMP in the
// browser, then show who scrobbles. Laid out like SettingRow, with room for the
// line about plays waiting to be sent and the link back to the browser page.
export component LastfmRow {
    private property <bool> connected: LastfmState.status == LastfmStatus.connected;
    private property <bool> waiting: LastfmState.status == LastfmStatus.waiting;
    private property <LastfmProblem> problem: LastfmState.problem;

    HorizontalLayout {
        spacing: Theme.space-xl;
        padding-top: Theme.space-m;
        padding-bottom: Theme.space-m;

        VerticalLayout {
            spacing: Theme.space-xs;
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: @tr("Scrobble to Last.fm");
                color: Theme.colors.text;
                font-size: Theme.font-body;
                font-weight: Theme.weight-strong;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }

            Text {
                text: root.connected ? (root.problem == LastfmProblem.keyring
                    ? @tr("Scrobbling as {0} until VCMP closes: the system keyring couldn't keep the key ({1}).", LastfmState.user, LastfmState.problem-detail)
                    : @tr("Scrobbling as {}. Last.fm receives the title, artist, album and length of each track you play, and what plays now.", LastfmState.user))
                    : root.waiting ? (root.problem == LastfmProblem.browser
                    ? @tr("Your browser didn't open ({}). Open the Last.fm page from here, and allow VCMP there.", LastfmState.problem-detail)
                    : @tr("Allow VCMP on the Last.fm page in your browser. Scrobbling starts as soon as you do."))
                    : root.problem == LastfmProblem.connect-failed ? @tr("VCMP couldn't connect to Last.fm: {}", LastfmState.problem-detail)
                    : root.problem == LastfmProblem.timed-out ? @tr("VCMP stopped waiting for you to allow it on Last.fm. Connect again to try once more.")
                    : root.problem == LastfmProblem.rejected ? @tr("Last.fm no longer accepts VCMP for {}, so scrobbling stopped. Connect again to send the plays that are waiting.", LastfmState.user)
                    : root.problem == LastfmProblem.key-missing ? @tr("The system keyring has no Last.fm key for {}. Connect again to keep scrobbling.", LastfmState.user)
                    : root.problem == LastfmProblem.keyring ? @tr("VCMP couldn't read the Last.fm key from the system keyring: {}", LastfmState.problem-detail)
                    : @tr("Keeps a record of what you listen to on your Last.fm profile. Last.fm receives the title, artist, album and length of each track you play, and what plays now.");
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }

            if root.connected && LastfmState.unsent > 0: Text {
                text: @tr("{n} play waits to be sent; disconnecting drops it." | "{n} plays wait to be sent; disconnecting drops them." % LastfmState.unsent);
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }

            if root.connected && LastfmState.unsent-loves > 0: Text {
                text: @tr("{n} love or unlove waits to be sent; disconnecting drops it." | "{n} loves and unloves wait to be sent; disconnecting drops them." % LastfmState.unsent-loves);
                color: Theme.colors.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
                min-height: self.preferred-height;
            }

            if root.waiting: TextLink {
                text: @tr("Open the Last.fm page again");
                font-size: Theme.font-small;
                clicked => {
                    LastfmState.open-auth-page();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            // One button for every state, so the focus stays on it as the state
            // changes.
            Button {
                text: root.connected ? @tr("Disconnect") : root.waiting ? @tr("Cancel") : @tr("Connect…");
                label: root.connected ? @tr("Disconnect from Last.fm") : root.waiting ? @tr("Stop connecting to Last.fm") : @tr("Connect to Last.fm");
                clicked => {
                    if root.connected {
                        LastfmState.disconnect();
                    } else if root.waiting {
                        LastfmState.cancel();
                    } else {
                        LastfmState.connect();
                    }
                }
            }
        }
    }
}
